# ==============================================================================
# AK5 Environment Configuration
# Copy this file to .env and customize as needed:
#   cp .env.example .env
# ==============================================================================

# Web Dashboard Authentication & Remote Access Security
# Leave AK5_AUTH_PASSWORD empty to disable login authentication for local dev.
AK5_AUTH_USERNAME=admin
AK5_AUTH_PASSWORD=your_secure_password_here

# Backend Gateway Port & Host (Optional overrides)
# Used by `ak5 web` / `ak5 serve` (bind defaults: web=0.0.0.0, serve=127.0.0.1)
# AK5_SERVER_HOST=0.0.0.0
# AK5_SERVER_PORT=8000

# Backend CORS Allowed Origins (Comma-separated)
# Default includes localhost, 127.0.0.1; Tailscale 100.x / *.ts.net via regex
# AK5_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
